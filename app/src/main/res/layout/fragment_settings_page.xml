<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/gotham"
                android:text="Settings"
                android:textColor="@color/md_theme_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/title_divider"
                android:layout_width="48dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp"
                app:dividerColor="@color/md_theme_primary" />

            <!-- General Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="#404040"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="General"
                        android:textColor="@color/md_theme_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:alpha="0.8" />

                    <RelativeLayout
                        android:id="@+id/samp_version_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/samp_version_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:fontFamily="@font/gotham"
                            android:text="SA-MP Version"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/samp_version_selector"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/samp_version"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>
                    </RelativeLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/newinterface_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="New Interface"
                        android:visibility="gone" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/systemkeyboard_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="System Keyboard" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/fastconnect_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fast Connect"
                        android:visibility="gone" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/voice_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Voice Chat" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/displayfps_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Display FPS" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/timestamp_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chat Timestamp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/fullscreen_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Full Screen Mode" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Game Files Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="#404040"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Loading and Scripts"
                        android:textColor="@color/md_theme_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:alpha="0.8" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/cleo_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CLEO Scripts" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/aml_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AML Scripts" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/monet_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="MonetLoader" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/modloader_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ModLoader" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/modify_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Modify Game Files" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="16dp"
                        app:dividerColor="#33FFFFFF" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/datatype_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="Data Type"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/datatype_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/data_full"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FULL"
                                android:checkable="true" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/data_lite"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LITE"
                                android:checkable="true" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </RelativeLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Advanced Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="#404040"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Advanced Settings"
                        android:textColor="@color/md_theme_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:alpha="0.8" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/chatstrings_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="Chat Strings"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/chatstrings_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chat_minus"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="48dp"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:insetLeft="0dp"
                                android:insetRight="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:padding="0dp"
                                android:text="-"
                                android:textColor="@color/md_theme_primary"
                                android:textSize="20sp"
                                android:textAllCaps="false" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chat_strings"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="72dp"
                                android:layout_height="match_parent"
                                android:clickable="false"
                                android:gravity="center"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:padding="0dp"
                                android:text="5"
                                android:textAllCaps="false"
                                android:textColor="@color/md_theme_onSurface"
                                android:textSize="16sp"
                                app:cornerRadius="0dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chat_plus"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="48dp"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:insetLeft="0dp"
                                android:insetRight="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:padding="0dp"
                                android:text="+"
                                android:textColor="@color/md_theme_primary"
                                android:textSize="20sp"
                                android:textAllCaps="false" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </RelativeLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="12dp"
                        app:dividerColor="#1AFFFFFF" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/chatposx_layout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:hint="Chat Pos X">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/chatposx"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/chatposy_layout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Chat Pos Y">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/chatposy"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/chatsizex_layout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:hint="Chat Size X">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/chatsizex"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/chatsizey_layout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Chat Size Y">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/chatsizey"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/restore_button"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="Restore Settings"
                app:icon="@drawable/ic_restore" />

            <!-- Hidden placeholders with correct types inside hierarchy to avoid ClassCastException in Java code -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                tools:ignore="UselessLeaf">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/fpslimit_layout"
                    android:layout_width="0dp"
                    android:layout_height="0dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/fpslimit_60" android:layout_width="0dp" android:layout_height="0dp" android:checkable="true" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/fpslimit_90" android:layout_width="0dp" android:layout_height="0dp" android:checkable="true" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/fpslimit_120" android:layout_width="0dp" android:layout_height="0dp" android:checkable="true" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.textview.MaterialTextView android:id="@+id/fpslimit_title" android:layout_width="0dp" android:layout_height="0dp" />
                <com.google.android.material.textview.MaterialTextView android:id="@+id/fontsize_title" android:layout_width="0dp" android:layout_height="0dp" />

                <com.google.android.material.textfield.TextInputLayout android:id="@+id/fontsize_layout" android:layout_width="0dp" android:layout_height="0dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/fontsize" android:layout_width="0dp" android:layout_height="0dp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>